<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Create User</h1>
</div>

<form>
    <div class="form-group">
        <label for="contactClient">User Name</label>
        <span class="star" aria-hidden="true">*</span>
        <input type="email" class="form-control" id="contactClient" placeholder="User Name">
    </div>
    <div class="form-group">
        <label for="subjectClient">Password</label>
        <span class="star" aria-hidden="true">*</span>
        <input type="email" class="form-control" id="subjectClient" placeholder="Password">
    </div>
    <div class="form-group">
        <label for="statusTicket">Status</label>
        <select class="form-control" id="statusTicket">
            <option>Choose</option>
            <option>Admin</option>
            <option>Service Engineer</option>
        </select>
    </div>
    
    <div class="d-sm-flex align-items-center justify-content-between mb-3">
        <a href="/ticket" class="d-none d-sm-inline-block btn btn-sm btn-success shadow-sm"><i
                class="fa fa-plus fa-lg"></i> Create User</a>
    </div>
</form>