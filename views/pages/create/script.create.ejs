  // });

  function loadTableData() {
    $.ajax({
      url: "/create/load", // The endpoint on your server
      method: "GET",
      // dataType: "json",
      success: function (data) {
        let tableRows = "";
        console.log(data);
        data.forEach((item) => {
          tableRows += `
                        <tr>
                            <td>${item.employeeID}</td>
                            <td>${item.firstName}</td>
                            <td>${item.lastName}</td>
                            <td>${item.middleName}</td>
                            <td>${item.address}</td>
                            <td>${item.userName}</td>
                            <td>${item.password}</td>
                            <td>${item.confirmPassword}</td>
                            <td>${item.dateNow}</td>
                             <td>${item.userRole}</td>
                        </tr>
                    `;
        });

        // Replace the content of the tbody
        $("#usertableBody").html(tableRows);
      },
      error: function (err) {
        console.error("Error fetching data:", err);
        $("#slbu-table").html(
          '<tr><td colspan="3">Failed to load data.</td></tr>',
        );
      },
    });
  }

  loadTableData();
  $(document).ready(function () {
    $("#adduserBtn").on("click", function (e) {
      e.preventDefault();

      const userList = {
        employeeID: $("#employeeID").val(),
        firstName: $("#firstName").val(),
        lastName: $("#lastName").val(),
        middleName: $("#middleName").val(),
        address: $("#address").val(),
        userName: $("#userName").val(),
        password: $("#password").val(),
        confirmPassword: $("#confirmPassword").val(),
        userRole: $("#userRole").val(),
      };
      $.ajax({
        url: "/create/add-user", // Your Express route
        type: "POST", // The method
        contentType: "application/json",
        data: JSON.stringify(userList),
        // headers: {
        //     'X-Custom-Header': 'MyValue'
        // },
        success: function (response) {
          // 'response' is the data sent from the server
          //   $("#result").text(
          //     "User Name: " + response.firstName + " " + response.lastName,
          //   );
          alert("Server: " + response.message);
          loadTableData();
        },
        error: function (xhr, status, error) {
          console.error("Something went wrong:", error);
        },
      });
    });
  });
</script>
